# Nexus Configuration
NODE_ENV=development
REALM_ENV=development
NEXUS_PORT=8080
NEXUS_HOST=0.0.0.0

# Realm Database (PostgreSQL)
# REALM_CONNECTION may be replaced by REALM_HOST, REALM_PORT, REALM_NAME, REALM_USER, and REALM_PASSWORD.
REALM_CONNECTION=postgresql://postgres:postgres@localhost:5432/everymusic_realm
REALM_POOL_MIN=2
REALM_POOL_MAX=10

# Cipher Configuration (CHANGE THESE!)
CIPHER_PRIMARY_KEY=replace-with-a-random-key-at-least-32-characters-long
CIPHER_REFRESH_KEY=replace-with-a-different-random-key-at-least-32-characters
TOKEN_LIFESPAN_MINUTES=30
REFRESH_LIFESPAN_DAYS=30
REFRESH_ROTATION_GRACE_SECONDS=30
TOKEN_ISSUER=every.music
TOKEN_AUDIENCE=every.music.clients

# Google Identity Gateway
GOOGLE_IDENTITY_KEY=your-google-client-id.apps.googleusercontent.com
GOOGLE_IDENTITY_LOCK=your-google-client-secret

# Mail Transporter
MAIL_GATEWAY=smtp.gmail.com
MAIL_PORT=587
MAIL_IDENTITY=your-email@gmail.com
MAIL_CREDENTIAL=your-app-password
MAIL_SENDER_ALIAS=Every.music <noreply@everymusic.com>

# Boundaries
PORTAL_ORIGINS=http://localhost:3000,http://tauri.localhost,tauri://localhost
TRUST_PROXY=false
RATE_WINDOW_MS=900000
RATE_THRESHOLD=150
UPLOAD_BYTE_LIMIT=5242880
