# Nexus Configuration
NODE_ENV=development
REALM_ENV=development
NEXUS_PORT=8080
NEXUS_HOST=0.0.0.0

# Realm Database (PostgreSQL)
# REALM_CONNECTION may be replaced by REALM_HOST, REALM_PORT, REALM_NAME, REALM_USER, and REALM_PASSWORD.
REALM_CONNECTION=postgresql://postgres:postgres@localhost:5432/everymusic_realm
REALM_POOL_MIN=2
REALM_POOL_MAX=10

# Cipher Configuration (CHANGE THESE!)
CIPHER_PRIMARY_KEY=replace-with-a-random-key-at-least-32-characters-long
CIPHER_REFRESH_KEY=replace-with-a-different-random-key-at-least-32-characters
TOKEN_LIFESPAN_MINUTES=30
REFRESH_LIFESPAN_DAYS=30
REFRESH_ROTATION_GRACE_SECONDS=30
TOKEN_ISSUER=every.music
TOKEN_AUDIENCE=every.music.clients

# Optional Google web sign-in: set a public web OAuth client ID to enable.
# The ID-token flow does not need a client secret.
GOOGLE_IDENTITY_KEY=

# Optional browser push: set all three together, or leave all empty.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Two-step verification and profile verification (all optional).
# TWO_FACTOR_ENCRYPTION_KEY: at least 32 characters; when empty, a key derived
# from CIPHER_PRIMARY_KEY seals TOTP secrets and SMS numbers. Changing the key
# in use makes existing authenticator and SMS enrollments unreadable.
TWO_FACTOR_ENCRYPTION_KEY=
VERIFICATION_MEDIA_RETENTION_DAYS=7
# SMS codes through Twilio: set the SID, token, and a sender number or
# messaging service. Leave all empty to hide the SMS option.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Minutes between checks of each band's public YouTube feed; 0 disables it.
YOUTUBE_FEED_INTERVAL_MINUTES=60

# Mail Transporter
MAIL_GATEWAY=smtp.gmail.com
MAIL_PORT=587
MAIL_IDENTITY=your-email@gmail.com
MAIL_CREDENTIAL=your-app-password
MAIL_SENDER_ALIAS=Every.music <noreply@everymusic.com>

# Scheduled notifications; email notifications use the mail transporter above.
NOTIFICATION_JOB_INTERVAL_MINUTES=60
STATS_DIGEST_WEEKDAY=1
STATS_DIGEST_MIN_EVENTS=1
COME_BACK_AFTER_DAYS=30
COME_BACK_MAX_REMINDERS=3
INVITE_NUDGE_AFTER_DAYS=7

# Boundaries
PORTAL_ORIGINS=http://localhost:3000,http://tauri.localhost,tauri://localhost
TRUST_PROXY=false
RATE_WINDOW_MS=900000
RATE_THRESHOLD=150
UPLOAD_BYTE_LIMIT=5242880

# Announcement applications: days kept after the call closes or the reply is withdrawn (1-3650).
APPLICATION_RETENTION_DAYS=90

# Marketplace listing lifetime and expiry reminder lead time, in days.
MARKETPLACE_LISTING_DAYS=60
MARKETPLACE_EXPIRY_REMINDER_DAYS=3

# Optional help center, legal templates, and client version notices.
# Operator details fill the legal templates; review them before going public.
# Changing TERMS_VERSION asks every existing account to accept the terms again.
APP_VERSION=1.0.0
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_JURISDICTION=
LEGAL_EFFECTIVE_DATE=
TERMS_VERSION=1
SUPPORT_EMAIL=
CLIENT_MIN_VERSION=
CLIENT_LATEST_VERSION=
CLIENT_UPDATE_URL=

ATTACHMENT_BYTE_LIMIT=10485760

# Media storage: postgres (default) or s3 for any S3-compatible service.
MEDIA_STORAGE=postgres
S3_ENDPOINT=
S3_REGION=us-east-1
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_FORCE_PATH_STYLE=false

# Optional native mobile push: set all values of a provider together, or leave empty.
# Private keys may use \n escapes on one line.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_ENVIRONMENT=production

# Seconds between checks for due calendar reminders (10-3600).
CALENDAR_REMINDER_INTERVAL_SECONDS=60
