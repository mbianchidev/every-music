POSTGRES_USER=everymusician
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=everymusic_realm

CIPHER_PRIMARY_KEY=replace-with-at-least-32-random-characters
CIPHER_REFRESH_KEY=replace-with-a-different-32-character-random-key

MAIL_GATEWAY=smtp.example.com
MAIL_PORT=587
MAIL_IDENTITY=noreply@example.com
MAIL_CREDENTIAL=replace-with-the-smtp-password
MAIL_SENDER_ALIAS=Every.music <noreply@example.com>

PORTAL_ORIGINS=http://localhost,http://localhost:3000,http://tauri.localhost,tauri://localhost
TOKEN_LIFESPAN_MINUTES=30
REFRESH_LIFESPAN_DAYS=30
REFRESH_ROTATION_GRACE_SECONDS=30
RATE_WINDOW_MS=900000
RATE_THRESHOLD=150

# Optional web Google sign-in and browser push.
GOOGLE_IDENTITY_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Optional media object storage. Leave MEDIA_STORAGE=postgres to keep uploads in
# PostgreSQL. For the bundled SeaweedFS service also set
# COMPOSE_PROFILES=object-storage; for an external bucket set S3_ENDPOINT.
MEDIA_STORAGE=postgres
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# COMPOSE_PROFILES=object-storage
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=everymusic-media
# S3_FORCE_PATH_STYLE=true
ATTACHMENT_BYTE_LIMIT=10485760

# Optional native mobile push. Set every value of a provider, or leave it empty.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_ENVIRONMENT=production
