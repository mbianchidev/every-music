POSTGRES_USER=everymusician
POSTGRES_PASSWORD=replace-with-a-long-random-password
POSTGRES_DB=everymusic_realm

CIPHER_PRIMARY_KEY=replace-with-at-least-32-random-characters
CIPHER_REFRESH_KEY=replace-with-a-different-32-character-random-key

MAIL_GATEWAY=smtp.example.com
MAIL_PORT=587
MAIL_IDENTITY=noreply@example.com
MAIL_CREDENTIAL=replace-with-the-smtp-password
MAIL_SENDER_ALIAS=Every.music <noreply@example.com>

PORTAL_ORIGINS=http://localhost,http://localhost:3000,http://tauri.localhost,tauri://localhost
TOKEN_LIFESPAN_MINUTES=30
REFRESH_LIFESPAN_DAYS=30
REFRESH_ROTATION_GRACE_SECONDS=30
RATE_WINDOW_MS=900000
RATE_THRESHOLD=150

# Days that applications stay readable after their announcement closes or they are withdrawn.
APPLICATION_RETENTION_DAYS=90

# Optional web Google sign-in and browser push.
GOOGLE_IDENTITY_KEY=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# Scheduled notifications (optional; defaults shown).
NOTIFICATION_JOB_INTERVAL_MINUTES=60
STATS_DIGEST_WEEKDAY=1
STATS_DIGEST_MIN_EVENTS=1
COME_BACK_AFTER_DAYS=30
COME_BACK_MAX_REMINDERS=3
INVITE_NUDGE_AFTER_DAYS=7

# Marketplace listing lifetime and expiry reminder lead time, in days.
MARKETPLACE_LISTING_DAYS=60
MARKETPLACE_EXPIRY_REMINDER_DAYS=3

# Optional two-step verification key, verification photo retention, and Twilio SMS.
TWO_FACTOR_ENCRYPTION_KEY=
VERIFICATION_MEDIA_RETENTION_DAYS=7
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
TWILIO_MESSAGING_SERVICE_SID=

# Optional help center, legal template, and client version settings.
APP_VERSION=1.0.0
OPERATOR_NAME=
OPERATOR_CONTACT_EMAIL=
OPERATOR_JURISDICTION=
LEGAL_EFFECTIVE_DATE=
TERMS_VERSION=1
SUPPORT_EMAIL=
CLIENT_MIN_VERSION=
CLIENT_LATEST_VERSION=
CLIENT_UPDATE_URL=

# Optional media object storage. Leave MEDIA_STORAGE=postgres to keep uploads in
# PostgreSQL. For the bundled SeaweedFS service also set
# COMPOSE_PROFILES=object-storage; for an external bucket set S3_ENDPOINT.
MEDIA_STORAGE=postgres
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# COMPOSE_PROFILES=object-storage
# S3_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# S3_REGION=auto
# S3_BUCKET=everymusic-media
# S3_FORCE_PATH_STYLE=true
ATTACHMENT_BYTE_LIMIT=10485760

# Optional native mobile push. Set every value of a provider, or leave it empty.
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_PRIVATE_KEY=
APNS_TOPIC=
APNS_ENVIRONMENT=production

# Minutes between checks of each band's public YouTube feed; 0 disables it.
YOUTUBE_FEED_INTERVAL_MINUTES=60

# Optional payments with Stripe Checkout (test-mode keys for development). The
# store and all payment routes stay disabled until both secrets are set; points
# earned in the app keep working without them. See docs/monetization.md.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PREMIUM_PRICE_ID=
STRIPE_PARTNER_PRICE_ID=
# id:points:price_id:amount_minor, comma separated, e.g. starter:500:price_123:499
STRIPE_POINTS_PACKS=
BILLING_CURRENCY=EUR
PREMIUM_MONTHLY_PRICE_MINOR=399
PARTNER_MONTHLY_PRICE_MINOR=1999
# Points prices and rewards. Durations are comma-separated day counts.
POINTS_PREMIUM_DAY_COST=20
POINTS_PREMIUM_DURATIONS_DAYS=7,30
POINTS_PROFILE_BOOST_DAY_COST=60
POINTS_ANNOUNCEMENT_BOOST_DAY_COST=60
POINTS_PIN_DAY_BASE_COST=80
POINTS_PIN_DAY_COST_PER_10_KM=10
POINTS_PIN_MAX_RADIUS_KM=200
POINTS_PROMOTION_DURATIONS_DAYS=1,3,7
POINTS_REFERRAL_INVITER=200
POINTS_REFERRAL_INVITEE=100
REFERRAL_MONTHLY_CAP=10
REFERRAL_CLAIM_DAYS=7
POINTS_APP_RATING=50
POINTS_REWARDED_VIDEO=10
REWARDED_VIDEO_DAILY_CAP=10
REWARDED_VIDEO_MIN_SECONDS=15
PROMOTED_RESULTS_PER_PAGE=2
SPONSORED_CARDS_PER_PAGE=1
# Raising this above 8388608 also needs a larger nginx client_max_body_size.
SPONSORED_VIDEO_BYTE_LIMIT=8388608
MONETIZATION_JOB_INTERVAL_MINUTES=15

# Seconds between checks for due event reminders; 0 disables reminder delivery.
EVENT_REMINDER_INTERVAL_SECONDS=60
